<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0D1117"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Верх: часы + погода, дата, последняя команда -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.42"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.4"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/dash_time"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:autoSizeMaxTextSize="80sp"
            android:autoSizeMinTextSize="20sp"
            android:autoSizeTextType="uniform"
            android:maxLines="1"
                android:fontFamily="sans-serif-light"
                android:gravity="center_vertical|start"
                android:includeFontPadding="false"
                android:textColor="#FFFFFFFF" />

            <TextView
                android:id="@+id/dash_weather"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:autoSizeMaxTextSize="30sp"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeTextType="uniform"
            android:maxLines="2"
                android:gravity="center_vertical|end"
                android:textColor="#FFFFFFFF" />
        </LinearLayout>

        <TextView
            android:id="@+id/dash_date"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.5"
            android:autoSizeMaxTextSize="20sp"
            android:autoSizeMinTextSize="9sp"
            android:autoSizeTextType="uniform"
            android:maxLines="1"
            android:gravity="center_vertical"
            android:textColor="#B3FFFFFF" />

        <TextView
            android:id="@+id/dash_last"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.7"
            android:autoSizeMaxTextSize="17sp"
            android:autoSizeMinTextSize="8sp"
            android:autoSizeTextType="uniform"
            android:maxLines="2"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:textColor="#FF00B4D8" />
    </LinearLayout>

    <!-- Низ: кнопки 3×3 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.58"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/btn_talk"
                style="@style/DashButton"
                android:background="@drawable/dash_talk"
                android:text="🎤\nГоворить" />
            <TextView
                android:id="@+id/btn_home"
                style="@style/DashButton"
                android:background="@drawable/dash_btn"
                android:text="🏠\nДомой" />
            <TextView
                android:id="@+id/btn_work"
                style="@style/DashButton"
                android:background="@drawable/dash_btn"
                android:text="💼\nРабота" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/btn_music"
                style="@style/DashButton"
                android:background="@drawable/dash_btn"
                android:text="🎵\nМузыка" />
            <TextView
                android:id="@+id/btn_split"
                style="@style/DashButton"
                android:background="@drawable/dash_btn"
                android:text="🪟\nКарта+YT" />
            <TextView
                android:id="@+id/btn_settings"
                style="@style/DashButton"
                android:background="@drawable/dash_btn"
                android:text="⚙\nНастройки" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/btn_prev"
                style="@style/DashButton"
                android:background="@drawable/dash_btn"
                android:text="⏮" />
            <TextView
                android:id="@+id/btn_play"
                style="@style/DashButton"
                android:background="@drawable/dash_btn"
                android:text="⏯" />
            <TextView
                android:id="@+id/btn_next"
                style="@style/DashButton"
                android:background="@drawable/dash_btn"
                android:text="⏭" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
