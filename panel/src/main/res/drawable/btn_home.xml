                    <corners android:radius="18dp" />
                </shape>
            </item>
            <!-- тень снизу для объёма -->
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="90" android:centerY="0.3"
                        android:startColor="#40000000" android:centerColor="#00000000" android:endColor="#00000000" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
            <!-- внешний тонкий край -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#00000000" />
                    <stroke android:width="1dp" android:color="#59000000" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
            <!-- светлая кромка стекла -->
            <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="#00000000" />
                    <stroke android:width="1dp" android:color="#73FFFFFF" />
                    <corners android:radius="17dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
