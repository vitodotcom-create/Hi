<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <!-- цветное стекло -->
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#CC7A8694" android:endColor="#CC2A313B" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
            <!-- блик в верхней половине -->
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:centerY="0.45"
                        android:startColor="#45FFFFFF" android:centerColor="#0AFFFFFF" android:endColor="#00FFFFFF" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
            <!-- светлая кромка стекла -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#00000000" />
                    <stroke android:width="2dp" android:color="#FFFFFFFF" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_focused="true">
        <layer-list>
            <!-- цветное стекло -->
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#AA7A8694" android:endColor="#AA2A313B" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
            <!-- блик в верхней половине -->
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:centerY="0.45"
                        android:startColor="#45FFFFFF" android:centerColor="#0AFFFFFF" android:endColor="#00FFFFFF" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
            <!-- светлая кромка стекла -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#00000000" />
                    <stroke android:width="2dp" android:color="#EEFFFFFF" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_hovered="true">
        <layer-list>
            <!-- цветное стекло -->
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#997A8694" android:endColor="#992A313B" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
            <!-- блик в верхней половине -->
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:centerY="0.45"
                        android:startColor="#45FFFFFF" android:centerColor="#0AFFFFFF" android:endColor="#00FFFFFF" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
            <!-- светлая кромка стекла -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#00000000" />
                    <stroke android:width="2dp" android:color="#BBFFFFFF" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <!-- цветное стекло -->
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#667A8694" android:endColor="#662A313B" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
            <!-- блик в верхней половине -->
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:centerY="0.45"
                        android:startColor="#45FFFFFF" android:centerColor="#0AFFFFFF" android:endColor="#00FFFFFF" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
            <!-- светлая кромка стекла -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#00000000" />
                    <stroke android:width="1dp" android:color="#55FFFFFF" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
