<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#FF5A6573" android:endColor="#FF2A313B" />
            <stroke android:width="2dp" android:color="#FFFFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#FF5A6573" android:endColor="#AA2A313B" />
            <stroke android:width="2dp" android:color="#FFFFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:state_hovered="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#FF5A6573" android:endColor="#AA2A313B" />
            <stroke android:width="2dp" android:color="#CCFFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#AA5A6573" android:endColor="#AA2A313B" />
            <stroke android:width="1dp" android:color="#55FFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
