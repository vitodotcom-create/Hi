<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#FF5B6CFF" android:endColor="#FF2E2F9C" />
            <stroke android:width="2dp" android:color="#FFFFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#FF5B6CFF" android:endColor="#CC2E2F9C" />
            <stroke android:width="2dp" android:color="#FFFFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:state_hovered="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#FF5B6CFF" android:endColor="#CC2E2F9C" />
            <stroke android:width="2dp" android:color="#CCFFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#CC5B6CFF" android:endColor="#CC2E2F9C" />
            <stroke android:width="1dp" android:color="#55FFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
