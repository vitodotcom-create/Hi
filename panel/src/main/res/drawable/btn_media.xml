<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <!-- цветное стекло -->
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#CCC0C8D0" android:endColor="#CC606870" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
            <!-- блик в верхней половине -->
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:centerY="0.45"
                        android:startColor="#45FFFFFF" android:centerColor="#0AFFFFFF" android:endColor="#00FFFFFF" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
            <!-- светлая кромка стекла -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#00000000" />
                    <stroke android:width="2dp" android:color="#FFFFFFFF" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_focused="true">
        <layer-list>
            <!-- цветное стекло -->
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#AAC0C8D0" android:endColor="#AA606870" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
            <!-- блик в верхней половине -->
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:centerY="0.45"
                        android:startColor="#45FFFFFF" android:centerColor="#0AFFFFFF" android:endColor="#00FFFFFF" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
            <!-- светлая кромка стекла -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#00000000" />
                    <stroke android:width="2dp" android:color="#EEFFFFFF" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_hovered="true">
        <layer-list>
            <!-- цветное стекло -->
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#99C0C8D0" android:endColor="#99606870" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
            <!-- блик в верхней половине -->
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:centerY="0.45"
                        android:startColor="#45FFFFFF" android:centerColor="#0AFFFFFF" android:endColor="#00FFFFFF" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
            <!-- светлая кромка стекла -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#00000000" />
                    <stroke android:width="2dp" android:color="#BBFFFFFF" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <!-- цветное стекло -->
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#66C0C8D0" android:endColor="#66606870" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
            <!-- блик в верхней половине -->
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:centerY="0.45"
                        android:startColor="#45FFFFFF" android:centerColor="#0AFFFFFF" android:endColor="#00FFFFFF" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
            <!-- светлая кромка стекла -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#00000000" />
                    <stroke android:width="1dp" android:color="#55FFFFFF" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
