<?xml version="1.0" encoding="utf-8"?>
<!-- «Стеклянная» кнопка: полупрозрачная, с тонкой серебристой рамкой; фокус шайбы — голубое свечение -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:endColor="#557FDBFF" android:startColor="#887FDBFF" />
            <stroke android:width="1dp" android:color="#FF7FDBFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:endColor="#22FFFFFF" android:startColor="#33FFFFFF" />
            <stroke android:width="2dp" android:color="#FF7FDBFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:state_hovered="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:endColor="#1AFFFFFF" android:startColor="#2EFFFFFF" />
            <stroke android:width="1dp" android:color="#AA7FDBFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:endColor="#0AFFFFFF" android:startColor="#1FFFFFFF" />
            <stroke android:width="1dp" android:color="#40C0C8D0" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
