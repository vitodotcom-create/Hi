<?xml version="1.0" encoding="utf-8"?>
<!-- Панель в стиле AMG: карбон с красной подсветкой, хромированные часы, плитки из цветного стекла. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF07080A">

    <com.carvoice.panel.AmgBackgroundView
        android:id="@+id/amg_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <!-- Часы со шкалой секунд и датчик погоды -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.2"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="4dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.3"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/time"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:autoSizeMaxTextSize="92sp"
                    android:autoSizeMinTextSize="20sp"
                    android:autoSizeTextType="uniform"
                    android:gravity="bottom|start"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.02"
                    android:maxLines="1"
                    android:paddingEnd="18dp"
                    android:shadowColor="#CC000000"
                    android:shadowDy="2"
                    android:shadowRadius="6"
                    android:textColor="#FFFFFFFF" />

                <com.carvoice.panel.SecondsBarView
                    android:id="@+id/seconds"
                    android:layout_width="match_parent"
                    android:layout_height="9dp"
                    android:layout_marginTop="3dp"
                    android:layout_marginEnd="24dp" />
            </LinearLayout>

            <com.carvoice.panel.WeatherGaugeView
                android:id="@+id/gauge"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.5" />

            <TextView
                android:id="@+id/weather"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical|end"
                android:letterSpacing="0.15"
                android:lineSpacingMultiplier="1.3"
                android:textColor="#FFAAB2BE"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Дата и надпись CLS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.06"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/date"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:autoSizeMaxTextSize="14sp"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeTextType="uniform"
                android:gravity="center_vertical"
                android:letterSpacing="0.22"
                android:maxLines="1"
                android:textAllCaps="true"
                android:textColor="#FFAAB2BE" />

            <TextView
                android:id="@+id/badge"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:autoSizeMaxTextSize="18sp"
                android:autoSizeMinTextSize="9sp"
                android:autoSizeTextType="uniform"
                android:gravity="center_vertical|end"
                android:maxLines="1"
                android:minWidth="60dp"
                android:textColor="#FFFFFFFF" />
        </LinearLayout>

        <!-- Красная подсветка -->
        <com.carvoice.panel.LightLineView
            android:id="@+id/light"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp" />

        <!-- Последняя команда -->
        <TextView
            android:id="@+id/last"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.07"
            android:autoSizeMaxTextSize="15sp"
            android:autoSizeMinTextSize="8sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="2"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textColor="#FFE8ECF2" />

        <!-- Кнопки-иконки: общие / навигация / голос и музыка + узкая полоса плеера.
             Каждая плитка — по центру своей колонки, поэтому у краёв остаётся промежуток. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.67"
            android:orientation="vertical">
    
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">
                <LinearLayout
                    android:id="@+id/btn_claude"
                    style="@style/IconCell"
                    android:layout_weight="1"
                    android:contentDescription="Claude">
                    <com.carvoice.panel.SquareTile
                        style="@style/IconTile"
                        android:background="@drawable/btn_claude"
                        android:src="@drawable/ic_mic" />
                    <TextView
                        android:id="@+id/btn_claude_label"
                        style="@style/IconLabel"
                        android:text="Claude" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/btn_split"
                    style="@style/IconCell"
                    android:layout_weight="1"
                    android:contentDescription="Экран ½">
                    <com.carvoice.panel.SquareTile
                        style="@style/IconTile"
                        android:background="@drawable/btn_split"
                        android:src="@drawable/ic_split" />
                    <TextView
                        android:id="@+id/btn_split_label"
                        style="@style/IconLabel"
                        android:text="Экран ½" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/btn_chrome"
                    style="@style/IconCell"
                    android:layout_weight="1"
                    android:contentDescription="Chrome">
                    <com.carvoice.panel.SquareTile
                        style="@style/IconTile"
                        android:background="@drawable/btn_chrome"
                        android:src="@drawable/ic_chrome" />
                    <TextView
                        android:id="@+id/btn_chrome_label"
                        style="@style/IconLabel"
                        android:text="Chrome" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/btn_wifi"
                    style="@style/IconCell"
                    android:layout_weight="1"
                    android:contentDescription="Wi-Fi">
                    <com.carvoice.panel.SquareTile
                        style="@style/IconTile"
                        android:background="@drawable/btn_wifi"
                        android:src="@drawable/ic_wifi" />
                    <TextView
                        android:id="@+id/btn_wifi_label"
                        style="@style/IconLabel"
                        android:text="Wi-Fi" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">
                <LinearLayout
                    android:id="@+id/btn_cam"
                    style="@style/IconCell"
                    android:layout_weight="1"
                    android:contentDescription="70mai">
                    <com.carvoice.panel.SquareTile
                        style="@style/IconTile"
                        android:background="@drawable/btn_cam"
                        android:src="@drawable/ic_cam" />
                    <TextView
                        android:id="@+id/btn_cam_label"
                        style="@style/IconLabel"
                        android:text="70mai" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/btn_home"
                    style="@style/IconCell"
                    android:layout_weight="1"
                    android:contentDescription="Домой">
                    <com.carvoice.panel.SquareTile
                        style="@style/IconTile"
                        android:background="@drawable/btn_home"
                        android:src="@drawable/ic_home" />
                    <TextView
                        android:id="@+id/btn_home_label"
                        style="@style/IconLabel"
                        android:text="Домой" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/btn_work"
                    style="@style/IconCell"
                    android:layout_weight="1"
                    android:contentDescription="Работа">
                    <com.carvoice.panel.SquareTile
                        style="@style/IconTile"
                        android:background="@drawable/btn_work"
                        android:src="@drawable/ic_work" />
                    <TextView
                        android:id="@+id/btn_work_label"
                        style="@style/IconLabel"
                        android:text="Работа" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/btn_fav"
                    style="@style/IconCell"
                    android:layout_weight="1"
                    android:contentDescription="Избранное">
                    <com.carvoice.panel.SquareTile
                        style="@style/IconTile"
                        android:background="@drawable/btn_fav"
                        android:src="@drawable/ic_star" />
                    <TextView
                        android:id="@+id/btn_fav_label"
                        style="@style/IconLabel"
                        android:text="Избранное" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">
                <LinearLayout
                    android:id="@+id/btn_gemini"
                    style="@style/IconCell"
                    android:layout_weight="1"
                    android:contentDescription="Gemini">
                    <com.carvoice.panel.SquareTile
                        style="@style/IconTile"
                        android:background="@drawable/btn_gemini"
                        android:src="@drawable/ic_gemini" />
                    <TextView
                        android:id="@+id/btn_gemini_label"
                        style="@style/IconLabel"
                        android:text="Gemini" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/btn_music"
                    style="@style/IconCell"
                    android:layout_weight="1"
                    android:contentDescription="Музыка">
                    <com.carvoice.panel.SquareTile
                        style="@style/IconTile"
                        android:background="@drawable/btn_music"
                        android:src="@drawable/ic_music" />
                    <TextView
                        android:id="@+id/btn_music_label"
                        style="@style/IconLabel"
                        android:text="Музыка" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/btn_radio"
                    style="@style/IconCell"
                    android:layout_weight="1"
                    android:contentDescription="Радио">
                    <com.carvoice.panel.SquareTile
                        style="@style/IconTile"
                        android:background="@drawable/btn_radio"
                        android:src="@drawable/ic_radio" />
                    <TextView
                        android:id="@+id/btn_radio_label"
                        style="@style/IconLabel"
                        android:text="Радио" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/btn_settings"
                    style="@style/IconCell"
                    android:layout_weight="1"
                    android:contentDescription="Настройки">
                    <com.carvoice.panel.SquareTile
                        style="@style/IconTile"
                        android:background="@drawable/btn_settings"
                        android:src="@drawable/ic_settings" />
                    <TextView
                        android:id="@+id/btn_settings_label"
                        style="@style/IconLabel"
                        android:text="Настройки" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.42"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/btn_prev"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="13dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_prev"
                    android:tint="#FFFFFFFF"
                    android:contentDescription="Предыдущий" />
                <ImageView
                    android:id="@+id/btn_play"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="2"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="13dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_play"
                    android:tint="#FFFFFFFF"
                    android:contentDescription="Пауза или воспроизведение" />
                <ImageView
                    android:id="@+id/btn_next"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="13dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_next"
                    android:tint="#FFFFFFFF"
                    android:contentDescription="Следующий" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
