<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/panel_bg"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <!-- Часы и погода -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.24"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/time"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:autoSizeMaxTextSize="84sp"
            android:autoSizeMinTextSize="20sp"
            android:autoSizeTextType="uniform"
            android:maxLines="1"
            android:fontFamily="sans-serif-thin"
            android:gravity="center_vertical|start"
            android:includeFontPadding="false"
            android:textColor="#FFFFFFFF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical|end"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1.4"
                android:gravity="bottom|end"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/weather_icon"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:adjustViewBounds="true"
                    android:scaleType="fitEnd"
                    android:importantForAccessibility="no" />

                <TextView
                android:id="@+id/temp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:autoSizeMaxTextSize="40sp"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeTextType="uniform"
            android:maxLines="1"
                android:fontFamily="sans-serif-light"
                android:gravity="bottom|end"
                android:textColor="#FFFFFFFF" />
            </LinearLayout>

            <TextView
                android:id="@+id/weather"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:autoSizeMaxTextSize="15sp"
            android:autoSizeMinTextSize="8sp"
            android:autoSizeTextType="uniform"
            android:maxLines="1"
                android:gravity="top|end"
                android:textColor="@color/silver" />
        </LinearLayout>
    </LinearLayout>

    <!-- Дата -->
    <TextView
        android:id="@+id/date"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.07"
        android:autoSizeMaxTextSize="15sp"
            android:autoSizeMinTextSize="8sp"
            android:autoSizeTextType="uniform"
            android:maxLines="1"
        android:gravity="center_vertical"
        android:letterSpacing="0.15"
        android:paddingStart="8dp"
        android:textAllCaps="true"
        android:textColor="@color/silver" />

    <!-- Хромированная линия -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="4dp"
        android:background="#33C0C8D0" />

    <!-- Последняя команда -->
    <TextView
        android:id="@+id/last"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.1"
        android:autoSizeMaxTextSize="15sp"
            android:autoSizeMinTextSize="8sp"
            android:autoSizeTextType="uniform"
            android:maxLines="2"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:textColor="@color/accent" />

    <!-- Кнопки-иконки: общие / навигация / голос и музыка + узкая полоса плеера.
         Каждая плитка — по центру своей колонки, поэтому у краёв остаётся промежуток. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.62"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <LinearLayout
                android:id="@+id/btn_claude"
                style="@style/IconCell"
                android:layout_weight="1"
                android:contentDescription="Claude">
                <com.carvoice.panel.SquareTile
                    style="@style/IconTile"
                    android:background="@drawable/btn_claude"
                    android:src="@drawable/ic_mic" />
                <TextView
                    android:id="@+id/btn_claude_label"
                    style="@style/IconLabel"
                    android:text="Claude" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/btn_split"
                style="@style/IconCell"
                android:layout_weight="1"
                android:contentDescription="Экран ½">
                <com.carvoice.panel.SquareTile
                    style="@style/IconTile"
                    android:background="@drawable/btn_split"
                    android:src="@drawable/ic_split" />
                <TextView
                    android:id="@+id/btn_split_label"
                    style="@style/IconLabel"
                    android:text="Экран ½" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/btn_chrome"
                style="@style/IconCell"
                android:layout_weight="1"
                android:contentDescription="Chrome">
                <com.carvoice.panel.SquareTile
                    style="@style/IconTile"
                    android:background="@drawable/btn_chrome"
                    android:src="@drawable/ic_chrome" />
                <TextView
                    android:id="@+id/btn_chrome_label"
                    style="@style/IconLabel"
                    android:text="Chrome" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/btn_wifi"
                style="@style/IconCell"
                android:layout_weight="1"
                android:contentDescription="Wi-Fi">
                <com.carvoice.panel.SquareTile
                    style="@style/IconTile"
                    android:background="@drawable/btn_wifi"
                    android:src="@drawable/ic_wifi" />
                <TextView
                    android:id="@+id/btn_wifi_label"
                    style="@style/IconLabel"
                    android:text="Wi-Fi" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <LinearLayout
                android:id="@+id/btn_nav"
                style="@style/IconCell"
                android:layout_weight="1"
                android:contentDescription="Навигатор">
                <com.carvoice.panel.SquareTile
                    style="@style/IconTile"
                    android:background="@drawable/btn_nav"
                    android:src="@drawable/ic_nav" />
                <TextView
                    android:id="@+id/btn_nav_label"
                    style="@style/IconLabel"
                    android:text="Навигатор" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/btn_home"
                style="@style/IconCell"
                android:layout_weight="1"
                android:contentDescription="Домой">
                <com.carvoice.panel.SquareTile
                    style="@style/IconTile"
                    android:background="@drawable/btn_home"
                    android:src="@drawable/ic_home" />
                <TextView
                    android:id="@+id/btn_home_label"
                    style="@style/IconLabel"
                    android:text="Домой" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/btn_work"
                style="@style/IconCell"
                android:layout_weight="1"
                android:contentDescription="Работа">
                <com.carvoice.panel.SquareTile
                    style="@style/IconTile"
                    android:background="@drawable/btn_work"
                    android:src="@drawable/ic_work" />
                <TextView
                    android:id="@+id/btn_work_label"
                    style="@style/IconLabel"
                    android:text="Работа" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/btn_fav"
                style="@style/IconCell"
                android:layout_weight="1"
                android:contentDescription="Избранное">
                <com.carvoice.panel.SquareTile
                    style="@style/IconTile"
                    android:background="@drawable/btn_fav"
                    android:src="@drawable/ic_star" />
                <TextView
                    android:id="@+id/btn_fav_label"
                    style="@style/IconLabel"
                    android:text="Избранное" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <LinearLayout
                android:id="@+id/btn_gemini"
                style="@style/IconCell"
                android:layout_weight="1"
                android:contentDescription="Gemini">
                <com.carvoice.panel.SquareTile
                    style="@style/IconTile"
                    android:background="@drawable/btn_gemini"
                    android:src="@drawable/ic_gemini" />
                <TextView
                    android:id="@+id/btn_gemini_label"
                    style="@style/IconLabel"
                    android:text="Gemini" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/btn_music"
                style="@style/IconCell"
                android:layout_weight="2"
                android:contentDescription="Музыка">
                <com.carvoice.panel.SquareTile
                    style="@style/IconTile"
                    android:background="@drawable/btn_music"
                    android:src="@drawable/ic_music" />
                <TextView
                    android:id="@+id/btn_music_label"
                    style="@style/IconLabel"
                    android:text="Музыка" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/btn_settings"
                style="@style/IconCell"
                android:layout_weight="1"
                android:contentDescription="Настройки">
                <com.carvoice.panel.SquareTile
                    style="@style/IconTile"
                    android:background="@drawable/btn_settings"
                    android:src="@drawable/ic_settings" />
                <TextView
                    android:id="@+id/btn_settings_label"
                    style="@style/IconLabel"
                    android:text="Настройки" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.55"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/btn_prev"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:background="@drawable/btn_media"
                android:clickable="true"
                android:focusable="true"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_prev"
                android:tint="#FFFFFFFF"
                android:contentDescription="Предыдущий" />
            <ImageView
                android:id="@+id/btn_play"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2"
                android:layout_margin="3dp"
                android:background="@drawable/btn_media"
                android:clickable="true"
                android:focusable="true"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_play"
                android:tint="#FFFFFFFF"
                android:contentDescription="Пауза или воспроизведение" />
            <ImageView
                android:id="@+id/btn_next"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:background="@drawable/btn_media"
                android:clickable="true"
                android:focusable="true"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_next"
                android:tint="#FFFFFFFF"
                android:contentDescription="Следующий" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
